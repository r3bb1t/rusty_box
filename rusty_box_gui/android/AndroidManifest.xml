<?xml version="1.0" encoding="utf-8"?>
<!--
  The manifest the APK ships. `cargo xtask android build` links it with aapt2
  and packs it with the native library cargo-apk builds and the dex of
  `java/`; the version code and name are cargo-apk's, from the crate version.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.rustybox.android">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="34" />

    <!-- Shared storage, for the file browser (src/android.rs). Up to Android 10
         the browser asks for READ and WRITE at runtime; from Android 11 it asks
         for "All files access" (MANAGE_EXTERNAL_STORAGE) instead, so READ and
         WRITE end at 29. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- VmService: while a VM runs, a foreground service with its notification,
         and a wake lock that keeps the processor running with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="Rusty Box"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
        android:hasCode="true">

        <!-- One activity for the process's life. android-activity runs one
             `android_main` per activity and winit makes one event loop per
             process, so a second instance or a re-created one cannot run:
             singleTask sends every launch to the activity there is, and
             configChanges names every configuration change, so Android tells
             the activity of each change rather than destroying it and making
             another (a night-time dark theme switches uiMode, for one). -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|density|screenSize|smallestScreenSize|layoutDirection|colorMode|fontWeightAdjustment|grammaticalGender">
            <meta-data
                android:name="android.app.lib_name"
                android:value="rusty_box_gui_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".VmService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the virtual machines the user powered on running until they are switched off" />
        </service>
    </application>
</manifest>
