+/*
+ * InsertPAC's selbit: the half of the address space whose extension and
+ * bottom PAC bit the code takes.  With two ranges that is ptr<55> when a
+ * top byte is ignored in either range and ptr<63> otherwise, whichever
+ * range ptr<55> itself selects.
+ */
+static int pauth_selbit(CPUARMState *env, uint64_t ptr, ARMMMUIdx mmu_idx,
+                        bool data, ARMVAParameters param)
+{
+    if (regime_has_2_ranges(mmu_idx)) {
+        uint64_t tcr = regime_tcr(env, mmu_idx);
+        int tbi = aa64_va_parameter_tbi(tcr, mmu_idx);
+
+        if (!data) {
+            tbi &= ~aa64_va_parameter_tbid(tcr, mmu_idx);
+        }
+        return extract64(ptr, tbi ? 55 : 63, 1);
+    }
+    return extract64(ptr, param.tbi ? 55 : 63, 1);
+}
