+/*
+ * Whether the event stream @control selects generates an event at a count
+ * after @from and no later than @to: a transition of the selected bit of
+ * the count from 0 to 1, or from 1 to 0 with EVNTDIR set.
+ */
+static bool gt_evt_between(uint32_t control, uint64_t from, uint64_t to)
+{
+    int bit;
+    uint64_t half, period, edge, next;
+
+    if (!FIELD_EX32(control, CNTxCTL, EVNTEN)) {
+        return false;
+    }
+    bit = FIELD_EX32(control, CNTxCTL, EVNTI) +
+        (FIELD_EX32(control, CNTxCTL, EVNTIS) ? 8 : 0);
+    half = BIT_ULL(bit);
+    period = half << 1;
+    /* The bit rises where a period's upper half starts. */
+    edge = FIELD_EX32(control, CNTxCTL, EVNTDIR) ? 0 : half;
+    /* Counts from @from to the first transition after it, 1 to period. */
+    next = ((edge + period - from % period - 1) % period) + 1;
+    return next <= to - from;
+}
+
+void gt_fold_event_stream(CPUARMState *env)
+{
+    uint64_t hcr = arm_hcr_el2_eff(env);
+    uint64_t now = gt_get_countervalue(env);
+    uint64_t from = env->evt_folded_to;
+    uint64_t offset = env->cp15.cntvoff_el2;
+    bool event = false;
+
+    /* TestEventCNTP(): CNTHCTL_EL2's stream, on the physical count. */
+    if (arm_feature(env, ARM_FEATURE_EL2)) {
+        event |= gt_evt_between(env->cp15.cnthctl_el2, from, now);
+    }
+    /*
+     * TestEventCNTV(): CNTKCTL_EL1's stream, on the physical count less
+     * CNTVOFF_EL2 whatever the current EL, unless E2H and TGE are both 1.
+     */
+    if ((hcr & (HCR_E2H | HCR_TGE)) != (HCR_E2H | HCR_TGE)) {
+        event |= gt_evt_between(env->cp15.c14_cntkctl,
+                                from - offset, now - offset);
+    }
+    if (event) {
+        qatomic_set(&env->event_register, true);
+    }
+    env->evt_folded_to = now;
+}
