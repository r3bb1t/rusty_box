 /* Return the current value of the system counter in ticks */
 uint64_t gt_get_countervalue(CPUARMState *env);
+
+/*
+ * Set the Event Register if an event stream has generated an event since
+ * the counter value it was last brought up to, which becomes the current
+ * one. The streams generate their events whatever the CPU is doing
+ * (TestEventCNTV(), TestEventCNTP()); they reach the register when it is
+ * read, and before a change of what selects them.
+ */
+void gt_fold_event_stream(CPUARMState *env);
+
+/*
+ * Whether CNTHCTL_EL2 or CNTKCTL_EL1 turns an event stream on. While
+ * neither does there is nothing to fold, and the write that turns one on
+ * folds first.
+ */
+static inline bool gt_event_stream_enabled(CPUARMState *env)
+{
+    return FIELD_EX32(env->cp15.cnthctl_el2, CNTxCTL, EVNTEN) ||
+        FIELD_EX32(env->cp15.c14_cntkctl, CNTxCTL, EVNTEN);
+}
