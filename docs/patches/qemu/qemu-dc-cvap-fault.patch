+/*
+ * The translation regime @mmu_idx without PAN, which does not apply to
+ * the AccessType_DC access of a data cache maintenance instruction by VA
+ * (CreateAccDescDC()).
+ */
+static ARMMMUIdx dc_mmu_idx(ARMMMUIdx mmu_idx)
+{
+    switch (mmu_idx) {
+    case ARMMMUIdx_E10_1_PAN:
+        return ARMMMUIdx_E10_1;
+    case ARMMMUIdx_E20_2_PAN:
+        return ARMMMUIdx_E20_2;
+    default:
+        return mmu_idx;
+    }
+}
+
+/*
+ * A clean by VA (DC CVAP, DC CVADP) of @vaddr whose read translation with
+ * @mmu_idx has failed. AArch64_S1CheckPermissions() and
+ * AArch64_S2CheckPermissions() give a clean a Permission fault only at
+ * EL0, for want of read permission, so above EL0 one completes; a
+ * Permission fault on the stage 1 walk's own stage 2 translation is the
+ * walk's, taken at any EL. Any other fault is taken with FAR_ELx the
+ * register's value (AArch64_DC()) and ESR_ELx.CM and WnR set
+ * (AArch64_FaultSyndrome() for AccessType_DC).
+ */
+static void dc_clean_fault(CPUARMState *env, uint64_t vaddr,
+                           ARMMMUIdx mmu_idx, uintptr_t ra)
+{
+#ifdef CONFIG_USER_ONLY
+    /* The page is not readable: the read's SIGSEGV reports it. */
+    probe_read(env, vaddr, 1, arm_to_core_mmu_idx(mmu_idx), ra);
+#else
+    GetPhysAddrResult res = {};
+    ARMMMUFaultInfo fi = {};
+
+    if (get_phys_addr(env, vaddr, MMU_DATA_LOAD, 0, mmu_idx, &res, &fi)) {
+        return;
+    }
+    if (fi.type == ARMFault_Permission && !fi.s1ptw &&
+        arm_current_el(env) != 0) {
+        return;
+    }
+    fi.cm = true;
+    cpu_restore_state(env_cpu(env), ra);
+    /*
+     * arm_deliver_fault() merges its syndrome into this template, which
+     * for a cache maintenance instruction holds nothing: ISV, which only
+     * a load or store of one register may set, is 0.
+     */
+    env->exception.syndrome = 0;
+    arm_deliver_fault(env_archcpu(env), vaddr, MMU_DATA_STORE,
+                      arm_to_core_mmu_idx(mmu_idx), &fi);
+#endif
+}
+#endif /* CONFIG_TCG */
