+/*
+ * FMAD, FMSB, FNMAD and FNMSB share the helpers of FMLA, FMLS, FNMLA and
+ * FNMLS, but have no BFloat16 form: size 00 is UNDEFINED.
+ */
+static bool do_fmad_zpzzz(DisasContext *s, arg_rprrr_esz *a,
+                          gen_helper_gvec_5_ptr *fn)
+{
+    if (a->esz == MO_8) {
+        return false;
+    }
+    return do_fmla_zpzzz(s, a, fn);
+}
+
+#define DO_FMAD(NAME, name)                                             \
+    TRANS_FEAT(NAME, aa64_sme_or_sve, do_fmad_zpzzz, a,                 \
+               s->fpcr_ah ? name##_ah_fns[a->esz] : name##_fns[a->esz])
+
+DO_FMAD(FMAD_zpzzz, fmla_zpzzz)
+DO_FMAD(FMSB_zpzzz, fmls_zpzzz)
+DO_FMAD(FNMAD_zpzzz, fnmla_zpzzz)
+DO_FMAD(FNMSB_zpzzz, fnmls_zpzzz)
+
+#undef DO_FMAD
